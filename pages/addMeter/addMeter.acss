.add-meter-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

input {
  width: 80%;
  padding: 10px;
  font-size: 16px;
  border-radius: 5px;
  border: 1px solid #ccc;
}

.picker {
  width: 80%;
  padding: 10px;
  font-size: 16px;
  border-radius: 5px;
  border: 1px solid #ccc;
  display: flex;
  align-items: center;
}
button {
  background-color: #4CAF50;
  color: white;
  padding: 10px 20px;
  font-size: 16px;
  border-radius: 5px;
  border: none;
  cursor: pointer;
  
  /* Apply flexbox to center the text */
  display: flex;
  justify-content: center;  /* Horizontally center the text */
  align-items: center;  /* Vertically center the text */
}

button:hover {
  background-color: #45a049;
}
