.consumption-page {
  display: flex;
  flex-direction: column;
  justify-content: center; /* vertically center */
  align-items: center;     /* horizontally center */
  padding: 24rpx;
  background-color: #f0f2f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.consumption-card {
  width: 100%;
  max-width: 600rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 32rpx;
}

.payment-details {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

input[type="number"] {
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid #f0f2f5;
  background-color: #f0f2f5;
}

button {
  width: 100%;
  max-width: 600rpx;
  background-color: #108ee9;
  color: #f0f2f5;
  padding: 20rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: background-color 0.3s ease;
}

button:hover {
  background-color: #0a7acc;
}
