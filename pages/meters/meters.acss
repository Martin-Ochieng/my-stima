.meters-page {
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  box-sizing: border-box;
  background-color: #f0f2f5;
  min-height: 100vh; /* Ensure it takes up full viewport height */
  overflow-y: auto; /* Allow scrolling if content overflows */
  padding-top: 60px; /* Extra space at the top for visibility */
}

.meters-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 20px;
  margin-top: 5px; /* Adds space between the top and the first meter card */
}

.meter-card {
  width: 100%;
  max-width: 600px;
  padding: 20px;
  background-color: #ffffff; /* Slightly darker than #f0f2f5 */
  border-radius: 12px;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.08);
  text-align: center;
}

.meter-info {
  margin-bottom: 12px;
  color: #222;
}

.meter-name {
  font-size: 20px;
  font-weight: 600;
}

.meter-number,
.meter-type,
.meter-units {
  font-size: 14px;
  margin-top: 4px;
  color: #666;
}

.meter-buttons {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 10px;
}



button {
  background-color: #4CAF50;
  color: white;
  padding: 10px 18px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
  transition: background-color 0.3s ease;

  /* Center text */
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;  /* fallback for inline-block buttons */
}

button:hover {
  background-color: #45a049;
}

.add-meter-button {
  margin-top: 30px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.add-meter-button button {
  background-color: #2196F3;
}

.add-meter-button button:hover {
  background-color: #1976D2;
}
