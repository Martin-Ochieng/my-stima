page {
  flex: 1;
  display: flex;
  flex-direction: column; /* Ensure items are arranged in a column */
  justify-content: center; /* Vertically center the page */
  align-items: center; /* Horizontally center the content */
  background: #f7f7f7; /* Background color for the page */
  height: 100vh; /* Ensure the page takes up the full height of the viewport */
  box-sizing: border-box; /* Ensure padding doesn't cause overflow */
}
